{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Structures",
  "description": "Contents of structures.json: connective-tissue structures (tendons, fascia) that connections link muscles through. Free-text fields are in Finnish.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "meshes", "name", "sources"],
    "properties": {
      "id": {
        "description": "Stable identifier in snake_case.",
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "meshes": {
        "description": "Mesh names in the 3D model, exactly as in the model file.",
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "name": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fi", "la"],
        "properties": {
          "fi": { "description": "Finnish name.", "type": "string", "minLength": 1 },
          "la": { "description": "Latin name (Terminologia Anatomica).", "type": "string", "minLength": 1 }
        }
      },
      "sources": {
        "description": "Ids of entries in sources.json that support this record.",
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    }
  }
}
